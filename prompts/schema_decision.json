{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoebAgentDecision",
  "type": "object",
  "required": [
    "as_of_date",
    "company",
    "ticker",
    "decision",
    "conviction",
    "target_size_pct_nav",
    "opportunity_template",
    "catalyst_role",
    "gate1_hard_fail",
    "valuation",
    "drivers",
    "kill_criteria",
    "what_would_change_our_mind",
    "memo",
    "uncited_claims"
  ],
  "properties": {
    "as_of_date": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "BUY",
        "SHORT",
        "PASS",
        "HOLD",
        "ADD",
        "TRIM",
        "SELL",
        "ESCALATE",
        "ADD_RISK",
        "REDUCE_GROSS",
        "HEDGE",
        "NO_CHANGE"
      ]
    },
    "conviction": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "target_size_pct_nav": {
      "type": "number"
    },
    "opportunity_template": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "catalyst_role": {
      "type": "string"
    },
    "gate1_hard_fail": {
      "type": "boolean"
    },
    "valuation": {
      "type": "object",
      "properties": {
        "entry_multiple": {
          "type": "string"
        },
        "eps_path": {
          "type": "string"
        },
        "terminal_multiple": {
          "type": "string"
        },
        "irr_pct": {
          "type": "number"
        },
        "downside_case": {
          "type": "string"
        }
      }
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "driver",
          "citations"
        ],
        "properties": {
          "driver": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "what_would_change_our_mind": {
      "type": "string"
    },
    "memo": {
      "type": "string"
    },
    "uncited_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instrument": {
      "type": "string"
    },
    "plan": {
      "type": "object"
    }
  }
}
